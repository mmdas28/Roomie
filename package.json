{
  "name": "roomie",
  "version": "0.1.0",
  "private": true,
  "description": "Roommates coordinating chores, schedules, and shared-living logistics — fairly.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @roomie/core test",
    "test:watch": "pnpm --filter @roomie/core test:watch",
    "dev": "pnpm --filter @roomie/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
