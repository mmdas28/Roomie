{
  "name": "roomie",
  "version": "0.1.0",
  "private": true,
  "description": "Roommates coordinating chores, schedules, and shared-living logistics — fairly.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
